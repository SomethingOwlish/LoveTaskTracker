{
  // Деплой: `npm run deploy` (сборка + wrangler deploy) или автосборка
  // Workers Builds из GitHub при пуше в main.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lovetasktracker",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // воркер запускается только для служебных путей Firebase Auth,
    // остальное — статика (бесплатно и без лимита запросов)
    "run_worker_first": ["/__/*"]
  },
  "observability": { "enabled": true },
  // Предварительные версии для веток и PR (Workers Builds → `wrangler preview`).
  // Выкладываются на отдельный адрес и не трогают основной.
  "previews": {}
}
