rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Только эти два адреса имеют доступ ко всем данным.
    function emails() {
      return ['argentummortis@gmail.com', 'arentakasi@gmail.com'];
    }
    function allowed() {
      return request.auth != null && request.auth.token.email in emails();
    }
    function me() {
      return request.auth.token.email;
    }
    // необязательное числовое поле
    function optNumber(d, f) {
      return !d.keys().hasAny([f]) || d[f] is number;
    }
    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    // ---------- Задачи ----------
    function validTask(d) {
      return shortText(d.title, 500) && d.title.size() > 0
        && d.status in ['open', 'in_progress', 'returned', 'in_review', 'done', 'approved']
        && d.authorUid in emails()
        && d.assigneeUid in emails();
    }
    match /tasks/{taskId} {
      allow read, delete: if allowed();
      allow create, update: if allowed() && validTask(request.resource.data);
      match /comments/{commentId} {
        allow read, delete: if allowed();
        allow create, update: if allowed() && shortText(request.resource.data.text, 4000);
      }
    }

    // старые однодневные события (только чтение и удаление из приложения)
    match /events/{eventId} {
      allow read, write: if allowed();
    }

    // ---------- События календаря (могут длиться несколько дней) ----------
    function validCalEvent(d) {
      return shortText(d.title, 300) && d.title.size() > 0
        && d.start is string && d.start.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.end is string && d.end.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.start <= d.end
        && d.authorUid in emails()
        && d.participants is list;
    }
    match /calEvents/{eventId} {
      allow read, delete: if allowed();
      allow create, update: if allowed() && validCalEvent(request.resource.data);
    }

    match /notifications/{notifId} {
      allow read, write: if allowed();
    }

    // Подписки на push: каждый пишет только свои, рассылка читает сервисным ключом.
    match /pushSubs/{id} {
      allow read: if allowed();
      allow create, update: if allowed() && request.resource.data.uid == me()
                            && request.resource.data.endpoint is string;
      allow delete: if allowed() && resource.data.uid == me();
    }

    // Публичный VAPID-ключ: пишет только setup-скрипт (сервисным ключом, мимо правил)
    match /pushConfig/{id} {
      allow read: if allowed();
      allow write: if false;
    }

    // Личное состояние: читать можно обоим, писать — только своё.
    match /userState/{uid} {
      allow read: if allowed();
      allow write: if allowed() && uid == me();
    }

    // ---------- Настроение ----------
    match /moods/{moodId} {
      allow read: if allowed();
      allow create, update: if allowed() && request.resource.data.uid == me()
                            && moodId.matches(me() + '_.*')
                            && request.resource.data.day is string;
      allow delete: if allowed() && moodId.matches(me() + '_.*');
    }
    match /moodLegends/{uid} {
      allow read: if allowed();
      allow write: if allowed() && uid == me();
    }

    // ---------- Мурмур ----------
    match /murmur/{itemId} {
      allow read, delete: if allowed();
      allow create, update: if allowed()
        && request.resource.data.kind in ['movie', 'series', 'game']
        && shortText(request.resource.data.title, 300)
        && request.resource.data.status in ['want', 'done'];
    }

    // ---------- Бюджет ----------
    match /wallets/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed()
        && shortText(request.resource.data.name, 100)
        && optNumber(request.resource.data, 'balance');
    }
    match /budgetTx/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed()
        && request.resource.data.type in ['income', 'expense', 'transfer']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount < 100000000
        && request.resource.data.planned is bool
        && optNumber(request.resource.data, 'fee')
        && (!request.resource.data.keys().hasAny(['fee']) || request.resource.data.fee >= 0);
    }
    match /budgetRecurring/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed()
        && request.resource.data.every in ['month', 'week']
        && request.resource.data.nextDate is string
        && request.resource.data.template.amount is number;
    }
    match /budgetSettings/{id} {
      allow read, write: if allowed();
    }
    // кэш курсов валют (пишет любой из двоих раз в 12 часов)
    match /fx/{id} {
      allow read, write: if allowed();
    }
    match /budgetProjects/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed()
        && shortText(request.resource.data.name, 200);
    }
    match /receipts/{id} {
      allow read, write: if allowed();
    }
    match /receiptImages/{id} {
      allow read, write: if allowed();
    }

    // ---------- Вишлист ----------
    match /wishlist/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed()
        && shortText(request.resource.data.title, 300) && request.resource.data.title.size() > 0
        && request.resource.data.type in ['need', 'games', 'gift', 'cute']
        && request.resource.data.status in ['want', 'got']
        && request.resource.data.ownerUid in emails()
        && (request.resource.data.price == null || request.resource.data.price is number)
        && (request.resource.data.url == null || shortText(request.resource.data.url, 2000));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
